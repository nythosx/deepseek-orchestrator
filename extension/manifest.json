{
  "manifest_version": 3,
  "name": "MyClaudeCode Agent",
  "version": "1.0",
  "description": "Autonomous coding agent via DeepSeek chat.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "nativeMessaging",
    "webNavigation",
    "webRequest"
  ],
  "host_permissions": [
    "http://localhost:8080/*",
    "https://chat.deepseek.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:8080/*",
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "lib/streamBridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "http://localhost:8080/*",
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+K"
      }
    }
  },
  "action": {
    "default_title": "MyClaudeCode Agent"
  },
  "key": ""
}
